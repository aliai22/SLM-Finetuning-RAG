# data/*

# --------------------------------------------------------------------
# Model Weights (tracked via Git LFS)
# --------------------------------------------------------------------
# Normally we ignore .pt/.bin/.safetensors globally to keep repo light,
# but we explicitly *un-ignore* the fine-tuned model folders you want in Git.

# Ignore globally (kept out by default)
*.pt
*.pth
*.bin
*.safetensors

# Allow (un-ignore) your specific fine-tuned model folders
!src/llmrag/models/gen_model/qa_pairs_finetuning/**
!src/llmrag/models/gen_model/text_chunks_finetuning/**
!src/llmrag/models/emb_model/**

# Optionally if you keep models elsewhere (training dirs)
!src/llmrag/training/finetuning_textbooks/**
!src/llmrag/training/finetuning_embeddmodel/**

# Allow specific curated datasets & config
!configs/**
!data/finetuning/**
!data/resources/**

